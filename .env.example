APP_NAME=Jobora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# OpenCode Zen (OpenAI-compatible) via Laravel AI SDK. O SDK anexa '/chat/completions' à base.
AI_PROVIDER=opencode_zen
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=mimo-v2.5-free
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# API de captura de vagas —credencial individual por usuário.
# Gere a credencial em /capture-setup após autenticar-se. As variáveis
# VAGAS_API_TOKEN / VAGAS_API_USER_ID foram descontinuadas e permanecem
# apenas para a migração única que converte o token legado no hash do owner.
# VAGAS_API_TOKEN=
# VAGAS_API_USER_ID=1

# PDF do currículo adaptado (F6) — driver cloudflare (Cloudflare Browser Run)
LARAVEL_PDF_DRIVER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

AUTH_EMAIL_VERIFICATION_EXPIRE=60
DB_QUEUE_AFTER_COMMIT=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=
REVERB_SERVER_HOST=
REVERB_SERVER_PORT=
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
